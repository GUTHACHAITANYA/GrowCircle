# ==========================================
# GrowCircle Environment Configuration
# ==========================================

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://growcircle:growcircle_dev@localhost:5432/growcircle_db
DATABASE_SYNC_URL=postgresql://growcircle:growcircle_dev@localhost:5432/growcircle_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External API Integrations (Keep empty for sandbox/mock fallback)
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# App Security
SECRET_KEY=dev-secret-key-growcircle-phase1-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
